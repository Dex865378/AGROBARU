rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura en las colecciones del protocolo AgroBarú
    match /agrobaru_users/{userId} {
      allow read, write: if true;
    }
    match /agrobaru_logs/{logId} {
      allow read, write: if true;
    }
    match /agrobaru_batches/{batchId} {
      allow read, write: if true;
    }
    match /agrobaru_orders/{orderId} {
      allow read, write: if true;
    }
    match /agrobaru_farms/{farmId} {
      allow read, write: if true;
    }
    match /agrobaru_alerts/{alertId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
